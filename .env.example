# Copia este archivo como .env. Son valores de desarrollo local.
HALITO_DB_HOST=localhost
HALITO_DB_PORT=5433
HALITO_DB_USER=halito
HALITO_DB_PASSWORD=halito_dev
HALITO_DB_NAME=halito

# Token de aplicación de datos.gov.co (gratuito). Se usa desde la fase 1.
HALITO_SOCRATA_APP_TOKEN=

# Solo para el despliegue (docker-compose.prod.yml).
# Dominio para el certificado HTTPS, o «:80» para servir por HTTP.
SITE_ADDRESS=:80
